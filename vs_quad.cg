/* Vertex-color passthrough with a single per-frame orthographic MVP, used for
 * every quad Render::DrawQuad submits (colored boxes only -- no texturing yet). */
void main
(
	float4 position	: POSITION,
	float4 color	: COLOR,

	uniform float4x4 ModelViewProjMatrix : C0,

	out float4 oPosition : POSITION,
	out float4 oColor    : COLOR
)
{
	oPosition = mul(ModelViewProjMatrix, position);
	oColor = color;
}
